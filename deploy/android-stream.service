[Unit]
Description=Android screen relay (adb + scrcpy-server -> WebRTC), fallback video source for the MT11 UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# Repository: https://github.com/robot-to-society/android-streaming (sibling checkout)
WorkingDirectory=/home/pi/github/android-streaming
Environment=PYTHONUNBUFFERED=1
# Signalling stays on localhost: the camera UI proxies /api/video/whep to it. Media (ICE) uses the Pi's own
# interfaces, so the browser must reach the Pi over UDP. --no-stay-awake: MIUI refuses the setting anyway.
ExecStart=/home/pi/github/android-streaming/.venv/bin/python -m android_stream.main --host 127.0.0.1 --port 8080 --no-stay-awake
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
